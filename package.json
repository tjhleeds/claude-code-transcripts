{
  "name": "claude-code-transcripts",
  "version": "1.0.0",
  "description": "Convert Claude Code session JSON to clean mobile-friendly HTML pages with pagination",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncmunson/claude-code-transcripts.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "claude-code-transcripts": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "claude",
    "transcripts",
    "html",
    "converter",
    "claude-code"
  ],
  "author": "John Munson",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "commander": "^13.0.0",
    "common-tags": "^1.8.2",
    "enquirer": "^2.4.1",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
